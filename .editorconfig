# Editor configuration for the whole repository, see https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.ts]
quote_type = single
ij_typescript_use_double_quotes = false

[*.md]
max_line_length = off
trim_trailing_whitespace = false

# Windows PowerShell 5.1 expects CRLF; the scripts also stay ASCII-only.
[*.ps1]
end_of_line = crlf
indent_size = 4

[*.cs]
indent_size = 4
