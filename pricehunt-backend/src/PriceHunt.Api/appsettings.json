{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true,
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss.fff "
      }
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Path": "App_Data/pricehunt.db"
  },
  "Search": {
    "MaxDuration": "00:00:06",
    "PersistenceTimeout": "00:00:05"
  },
  "Simulation": {
    "Seed": null,
    "MinDelay": "00:00:00.500",
    "MaxDelay": "00:00:05",
    "Suppliers": [
      { "Id": "albatross-freight", "Name": "Albatross Freight", "Behavior": "Reliable", "MinPrice": 1180, "MaxPrice": 1890 },
      { "Id": "bramblewood-cargo", "Name": "Bramblewood Cargo", "Behavior": "Reliable", "MinPrice": 960, "MaxPrice": 1720 },
      { "Id": "cobalt-harbor-lines", "Name": "Cobalt Harbor Lines", "Behavior": "Reliable", "MinPrice": 1040, "MaxPrice": 2080 },
      { "Id": "driftwood-shipping", "Name": "Driftwood Shipping", "Behavior": "Flaky", "FailureRate": 0.3, "MinPrice": 880, "MaxPrice": 1610 },
      { "Id": "emberline-logistics", "Name": "Emberline Logistics", "Behavior": "Reliable", "MinPrice": 1290, "MaxPrice": 2390 },
      { "Id": "foxglove-freightways", "Name": "Foxglove Freightways", "Behavior": "Reliable", "MinPrice": 930, "MaxPrice": 1810 },
      { "Id": "gullwing-transport", "Name": "Gullwing Transport", "Behavior": "Unresponsive" }
    ]
  }
}
